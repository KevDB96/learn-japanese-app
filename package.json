{
  "name": "learn-japanese-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run src --environment jsdom",
    "assets:validate": "node scripts/assets-validate.mjs",
    "content:validate": "node --experimental-strip-types scripts/content-validate.ts",
    "build": "npm run assets:validate && tsc -b && vite build && node scripts/generate-service-worker.mjs",
    "test:browser": "playwright test",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
