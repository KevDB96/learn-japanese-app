  "lessons": [
    {
      "id": "introduction",
      "display": "Welcome to Japanese",
      "requires": [],
      "introduces": [],
      "reinforces": [],
      "blocks": [
        {
          "id": "intro-title",
          "kind": "heading",
          "text": "Welcome to Japanese"
        },
        {
          "id": "writing-systems",
          "kind": "paragraph",
          "text": "Japanese uses three writing systems. Hiragana writes native words and grammar endings. Katakana writes many borrowed words and names. Kanji are characters that carry meaning."
        },
        {
          "id": "hiragana-example",
          "kind": "japanese-example",
          "japanese": "こんにちは",
          "reading": "konnichiwa",
          "translation": "Hello"
        },
        {
          "id": "romaji-note",
          "kind": "callout",
          "title": "A note about romaji",
          "text": "Romaji (Japanese written with Latin letters) can help at first. We will use less of it as you learn kana, so you can read Japanese directly."
        },
        {
          "id": "learning-model",
          "kind": "checkpoint",
          "title": "How learning works",
          "points": [
            "Lessons teach new ideas.",
            "Exercises build understanding.",
            "Reviews help you remember.",
            "The curriculum chooses what comes next."
          ]
        },
        {
          "id": "intro-exercises",
          "kind": "exercise-slot",
          "title": "Quick check",
          "exercises": [
            {
              "id": "writing-system-check",
              "type": "multiple-choice",
              "prompt": "Which script commonly writes borrowed words?",
              "options": [
                "Hiragana",
                "Katakana",
                "Kanji"
              ],
              "answer": "Katakana",
              "feedback": {
                "success": "Correct.",
                "explanation": "Katakana commonly writes borrowed words and names."
              }
            },
            {
              "id": "hello-script-check",
              "type": "character-selection",
              "prompt": "Select the Japanese greeting.",
              "options": [
                "こんにちは",
                "hello",
                "ありがとう"
              ],
              "answer": "こんにちは",
              "feedback": {
                "success": "Correct.",
                "explanation": "こんにちは is a Japanese greeting meaning hello."
              }
            },
            {
              "id": "lesson-model-check",
              "type": "short-text",
              "prompt": "What helps you remember over time?",
              "answer": "Reviews",
              "acceptedAnswers": [
                "reviews"
              ],
              "feedback": {
                "success": "Correct.",
                "explanation": "Reviews help strengthen memory over time."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "hiragana-a-row",
      "display": "Hiragana ? row",
      "requires": [
        "introduction"
      ],
      "introduces": [
        "kana-hira-a",
        "kana-hira-i",
        "kana-hira-u",
        "kana-hira-e",
        "kana-hira-o"
      ],
      "reinforces": [],
      "blocks": [
        {
          "id": "hiragana-a-row-title",
          "kind": "heading",
          "text": "Hiragana: ? row"
        },
        {
          "id": "hiragana-a-row-teach",
          "kind": "paragraph",
          "text": "These five vowels are the basic sounds used throughout Japanese. Say each sound clearly and briefly."
        },
        {
          "id": "hiragana-a-row-readout",
          "kind": "kana-grid",
          "title": "Look, say, remember",
          "characters": [
            {
              "kana": "あ",
              "reading": "a"
            },
            {
              "kana": "い",
              "reading": "i"
            },
            {
              "kana": "う",
              "reading": "u"
            },
            {
              "kana": "え",
              "reading": "e"
            },
            {
              "kana": "お",
              "reading": "o"
            }
          ]
        },
        {
          "id": "hiragana-a-row-guided",
          "kind": "exercise-slot",
          "title": "Guided practice",
          "exercises": [
            {
              "id": "hiragana-a-row-guided-1",
              "type": "character-selection",
              "prompt": "Choose あ (a).",
              "options": [
                "あ",
                "い",
                "え"
              ],
              "answer": "あ",
              "feedback": {
                "success": "Correct.",
                "explanation": "あ is read a."
              }
            },
            {
              "id": "hiragana-a-row-guided-3",
              "type": "character-selection",
              "prompt": "Choose う (u).",
              "options": [
                "う",
                "え",
                "あ"
              ],
              "answer": "う",
              "feedback": {
                "success": "Correct.",
                "explanation": "う is read u."
              }
            },
            {
              "id": "hiragana-a-row-guided-5",
              "type": "character-selection",
              "prompt": "Choose お (o).",
              "options": [
                "お",
                "あ",
                "う"
              ],
              "answer": "お",
              "feedback": {
                "success": "Correct.",
                "explanation": "お is read o."
              }
            }
          ]
        },
        {
          "id": "hiragana-a-row-retrieval-note",
          "kind": "callout",
          "title": "Read without romaji",
          "text": "Cover the readings above. Recall each sound from the hiragana alone."
        },
        {
          "id": "hiragana-a-row-retrieval",
          "kind": "exercise-slot",
          "title": "Quick recall",
          "exercises": [
            {
              "id": "hiragana-a-row-recall-1",
              "type": "short-text",
              "prompt": "Type the sound for あ.",
              "answer": "a",
              "feedback": {
                "success": "Correct.",
                "explanation": "あ is read a."
              }
            },
            {
              "id": "hiragana-a-row-recall-5",
              "type": "short-text",
              "prompt": "Type the sound for お.",
              "answer": "o",
              "feedback": {
                "success": "Correct.",
                "explanation": "お is read o."
              }
            }
          ]
        }
      ]
    },
